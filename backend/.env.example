# ==============================================================================
# Angel One SmartAPI Credentials & Configuration
# Obtain credentials from: https://smartapi.angelbroking.com/
# ==============================================================================

# Your SmartAPI App API Key
ANGEL_API_KEY="YOUR_SMARTAPI_API_KEY"

# Your Angel One Client Code (e.g. A123456)
ANGEL_CLIENT_CODE="YOUR_CLIENT_CODE"

# Your 4-digit Account PIN
ANGEL_PIN="1234"

# Your 32-character Base32 TOTP Secret Key (from Authenticator setup)
ANGEL_TOTP_KEY="YOUR_BASE32_TOTP_KEY"

# Server Host and Port
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# When True, if credentials are missing or outside market hours, the backend
# runs a high-fidelity real-time tick simulator generating live NIFTY & BANKNIFTY
# option chain ticks with real VWAP & OI accumulation.
SIMULATION_MODE=true

# Number of strikes above and below ATM to subscribe on WebSocket
OPTION_CHAIN_STRIKE_DEPTH=8
